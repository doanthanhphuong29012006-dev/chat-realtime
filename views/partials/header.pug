header.chat-header
  .logo.d-flex.align-items-center.gap-4
    a(href="/")
      img.header-logo(src="/images/rat.svg", alt="Logo Chat Chit")
      span.logo-text
        i.fa-solid.fa-house
        | Trang chủ
    
    a(href="/rooms-chat")
      span.logo-text
        i.fa-solid.fa-comments
        | Phòng chat

  .user-profile
    a(href=`/user/edit`)
      .avatar-mini
        img(
          src=user.avatar
          alt=user.fullName
        )
        
    span.username #{user.fullName}
    a(href="/auth/logout")
      button.btn-logout Đăng xuất