.users-nav.mb-4
    a(
        class="btn-custom btn-nav active"
        href="/users/suggestions"
    ) <i class="fa-solid fa-users me-2"></i> Gợi ý kết bạn

    a(
        class="btn-custom btn-nav"
        href="/users/friends"
    ) <i class="fa-solid fa-user-group me-2"></i> Danh sách bạn bè

    a(
        class="btn-custom btn-nav"
        href="/users/requests"
    ) <i class="fa-solid fa-user-clock me-2"></i> Lời mời đã gửi

    a(
        class="btn-custom btn-nav"
        href="/users/accept"
    ) 
        <i class="fa-solid fa-user-check me-2"></i> Lời mời kết bạn
        span(
            class="badge-notify"
            badge-users-accept=user.id
        ) #{user.acceptFriends.length}