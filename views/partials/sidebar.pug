aside.chat-sidebar
  .search-container
    input#search-input(type="text", placeholder="Tìm kiếm liên hệ hoặc nhóm...")
  
  .contact-list
    ul
      each item in sidebarData
        li.contact-item(class=(roomChatId === item.roomChatId ? "active" : ""))
          a.contact-link(href=`/chat/${item.roomChatId}`)
            .contact-avatar
              img(
                  src=item.roomAvatar
                  alt=item.roomName
              )
              if item.partnerId
                span.status-dot(
                  user-id=item.partnerId
                  class=(item.statusOnline === 'online' ? 'online' : 'offline')
                )
            .contact-info
              h4.contact-name #{item.roomName}
              p.last-message #{item.lastMessage}
            .contact-meta
              span.time #{item.messageTime}