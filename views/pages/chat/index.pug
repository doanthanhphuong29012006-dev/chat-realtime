extends ../../layouts/default.pug

block main
    .row
        .col-12
            .chat(
                my-id=user.id
                my-name=user.fullName
                room-id=roomChat._id
            )
                .inner-head
                    .inner-avatar
                        img(
                            src=(roomChat.typeRoom === "group") ? roomChat.avatar : partner.avatar
                            alt=(roomChat.typeRoom === "group") ? roomChat.title : partner.fullName
                        )
                    .inner-info
                        .inner-name #{(roomChat.typeRoom === "group") ? roomChat.title : partner.fullName}
                        .inner-status 
                            i(class="fa-solid fa-circle")
                            span Đang hoạt động

                .inner-body
                    each chat in chats
                        div(class=(user.id == chat.user_id ? "inner-outgoing" : "inner-incoming"))
                            if (user.id != chat.user_id)
                                .inner-name #{chat.userInfo.fullName}
                            
                            if (chat.content)
                                .inner-content
                                    | #{chat.content}

                            if (chat.images && chat.images.length > 0)
                                .inner-images
                                    each image in chat.images 
                                        img(src=image)

                    div(class="inner-list-typing")

                .inner-foot
                    form(
                        class="inner-form"
                        action=""
                    )
                        input(
                            type="text"
                            placeholder="Nhập nội dung..."
                            name="content"
                        )

                        span(class="button-icon button-image")
                            i.fa-regular.fa-image

                        span(class="button-icon button-smile")
                            i.fa-regular.fa-face-smile

                        button
                            i.fa-solid.fa-paper-plane
                        div(class="tooltip" role="tooltip")
                            emoji-picker

                    .inner-preview-images
                        div(
                            class="custom-file-container" 
                            data-upload-id="upload-images"
                        )

block script 
    script(type="module" src="/js/chat.js")