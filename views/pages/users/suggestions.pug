extends ../../layouts/default-no-sidebar.pug
include ../../mixins/box-head.pug

block main 
    .container.my-4
        include ../../partials/list-btn-users.pug

        .row.mb-4
            .col-12 
                +box-head("Gợi ý kết bạn")

        .row
            each user in users
                .col-6
                    div(
                        class="box-user"
                    )
                        div.inner-avatar
                            img(
                                src=(user.avatar ? user.avatar : "/images/avatar.jpg")
                                alt=user.fullName
                            )

                        div.inner-info
                            div.inner-name #{user.fullName}
                            div.inner-buttons
                                button(
                                    class="btn btn-sm btn-primary btn-add-friend"
                                    button-add-friend=user.id
                                ) Kết bạn
                                button(
                                    class="btn btn-sm btn-light btn-cancel"
                                    button-cancel=user.id
                                ) Hủy

block script 
    script(src="/js/users.js")