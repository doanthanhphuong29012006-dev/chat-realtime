extends ../../layouts/default-no-sidebar.pug
include ../../mixins/box-head.pug

block main
    .container.my-3

        include ../../partials/list-btn-users.pug

        .row
            .col-12
                +box-head("Lời mời đã gửi")

        .row
            each user in users
                .col-6
                    div(
                        class="box-user add"
                    )
                        div.inner-avatar
                            img(
                                src=user.avatar
                                alt=user.fullName
                            )

                        div.inner-info
                            div.inner-name #{user.fullName}
                            div.inner-buttons
                                button(
                                    class="btn btn-sm btn-primary btn-add-friend"
                                    button-add-friend=user.id
                                ) Kết bạn
                                button(
                                    class="btn btn-sm btn-light btn-cancel"
                                    button-cancel=user.id
                                ) Hủy

block script
    script(src="/js/users.js")