extends ../../layouts/default-no-sidebar.pug

block main
    .welcome-screen.d-flex.flex-column.align-items-center.justify-content-center.w-100
        img.welcome-logo.mb-4(
            src="/images/rat.svg" 
            alt="Chat Chit Logo"
        )
        
        h2.welcome-title Chào mừng đến với Chat Chit!
        p.welcome-desc Khám phá những câu chuyện thú vị. Hãy chọn một đoạn chat ở thanh bên trái hoặc tìm kiếm bạn bè để bắt đầu cuộc trò chuyện.
        
        a.btn.btn-primary.btn-welcome-action.mt-3(href="/users/friends")
            i.fa-solid.fa-user-group.me-2
            | Xem danh sách bạn bè