extends ../../layouts/default-no-sidebar.pug
include ../../mixins/box-head.pug

block main
    .container.my-4
        .row
            .col-12
                +box-head("Danh sách phòng")

        .row.mb-4
            .col-12
                a(
                    href="/rooms-chat/create"
                    class="btn-create-room"
                ) 
                    i.fa-solid.fa-plus.me-2
                    | Tạo phòng chat

        .row
            .col-6
                each room in myRooms
                    div(class="box-room")
                        div(class="inner-avatar")
                            img(
                                src=room.avatar
                                alt=room.title
                            )

                        div(class="inner-info")
                            div(class="inner-name") #{room.title}

                            div(class="inner-buttons")
                                a(
                                    href=`/chat/${room._id}`
                                    class="btn btn-sm btn-primary"
                                ) Nhắn tin